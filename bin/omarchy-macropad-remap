#!/bin/bash
# Omarchy trigger: pick a macropad key/knob action from a menu, press the
# real-keyboard shortcut you want assigned to it, then confirm before it's
# written to the device.
set -euo pipefail

APPLY="$HOME/.local/bin/omarchy-macropad-apply.py"

if ! command -v ch57x-keyboard-tool >/dev/null 2>&1; then
  notify-send -u critical "Macropad remap" "ch57x-keyboard-tool not found"
  exit 1
fi

declare -A SLOTS=(
  ["Key 1"]="button1"
  ["Key 2"]="button2"
  ["Key 3"]="button3"
  ["Knob ⟲ turn left (CCW)"]="knob_ccw"
  ["Knob press (click)"]="knob_press"
  ["Knob ⟳ turn right (CW)"]="knob_cw"
  ["LED backlight"]="led"
)
ORDER=("Key 1" "Key 2" "Key 3" "Knob ⟲ turn left (CCW)" "Knob press (click)" "Knob ⟳ turn right (CW)" "LED backlight")

# Empirically-picked wraparound range for the Next/Previous cycle below — see
# LED_MODE_COUNT's comment in omarchy-macropad-apply.py for why this isn't a
# confirmed mode count.
LED_MODE_COUNT=16

current_json=$(python3 "$APPLY" current 2>/dev/null || echo '{}')

labels=()
declare -A LABEL_TO_NAME=()
for name in "${ORDER[@]}"; do
  slot="${SLOTS[$name]}"
  if [[ "$slot" == "led" ]]; then
    value=$(jq -r '.led_mode // 0' <<<"$current_json")
    label="$name  →  mode $value"
  else
    value=$(jq -r --arg k "$slot" '.[$k] // ""' <<<"$current_json")
    if [[ -n "$value" ]]; then
      label="$name  →  $value"
    else
      label="$name"
    fi
  fi
  labels+=("$label")
  LABEL_TO_NAME["$label"]="$name"
done

MENU_WIDTH=480

selection=$(omarchy-menu-select "Remap which macropad control?" "${labels[@]}" -- --width "$MENU_WIDTH") || exit 0
[[ -z "$selection" ]] && exit 0

name="${LABEL_TO_NAME[$selection]:-}"
[[ -n "$name" ]] || exit 0
slot="${SLOTS[$name]}"

if [[ "$slot" == "led" ]]; then
  mode=$(jq -r '.led_mode // 0' <<<"$current_json")
  while true; do
    choice=$(omarchy-menu-select "LED backlight — mode $mode" "Next ▶" "◀ Previous" "Done" -- --width "$MENU_WIDTH") || break
    case "$choice" in
      "Next ▶")
        mode=$(( (mode + 1) % LED_MODE_COUNT ))
        python3 "$APPLY" led "$mode" >/dev/null || true
        ;;
      "◀ Previous")
        mode=$(( (mode - 1 + LED_MODE_COUNT) % LED_MODE_COUNT ))
        python3 "$APPLY" led "$mode" >/dev/null || true
        ;;
      *)
        break
        ;;
    esac
  done
  exit 0
fi

capture_json=$(python3 "$APPLY" capture "$slot") || exit 0
status=$(jq -r '.status' <<<"$capture_json")
[[ "$status" == "ok" ]] || exit 0
token=$(jq -r '.token' <<<"$capture_json")

confirm=$(omarchy-menu-select "Assign $name → $token?" "Yes" "No" -- --width "$MENU_WIDTH") || exit 0
[[ "$confirm" == "Yes" ]] || exit 0

exec python3 "$APPLY" apply "$slot" "$token"
